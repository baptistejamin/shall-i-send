{
  "name": "shall-i-send",
  "description": "Shall I send?",
  "version": "1.0.0",
  "homepage": "https://github.com/baptistejamin/shall-i-send",
  "license": "MIT",
  "author": {
    "name": "Baptiste Jamin",
    "email": "baptiste@crisp.chat",
    "url": "https://jamin.me/"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/baptistejamin/shall-i-send.git"
  },
  "bugs": {
    "url": "https://github.com/baptistejamin/shall-i-send/issues"
  },
  "main": "dist/shall-i-send.js",
  "types": "dist/shall-i-send.d.ts",
  "exports": {
    ".": {
      "types": "./dist/shall-i-send.d.ts",
      "import": "./dist/shall-i-send.js",
      "require": "./dist/shall-i-send.js"
    }
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "scripts": {
    "lint": "eslint lib test",
    "unit": "jest --config jest.config.mjs",
    "test": "npm run lint && npm run unit",
    "build": "npx tsc -p tsconfig.build.json && npx tsc-alias -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "29.5.12",
    "@types/node": "18.19.130",
    "@typescript-eslint/eslint-plugin": "8.39.1",
    "tsc-alias": "1.8.16",
    "typescript": "5.9.3",
    "eslint": "9.39.1",
    "eslint-plugin-crisp": "1.4.12",
    "eslint-plugin-jest": "29.0.0",
    "eslint-plugin-jsdoc": "54.1.0",
    "globals": "15.15.0",
    "jest": "29.7.0",
    "ts-jest": "29.4.5"
  },
  "keywords": [
    "send-time",
    "message",
    "scheduling",
    "timezone",
    "availability",
    "campaign",
    "email",
    "optimization"
  ]
}
